# 复制为 .env 使用；生产环境务必修改密码与 JWT_SECRET
# PostgreSQL（docker-compose.dev.yml / docker-compose.yml 中的默认凭据）
DATABASE_URL=postgresql://cps:cps123456@localhost:15432/cps?schema=public
REDIS_URL=redis://localhost:16379
# 服务端监听端口
PORT=3000
# JWT 签名密钥（生产必改，建议 openssl rand -hex 32 生成）
JWT_SECRET=change-me-in-production
# 媒体文件本地存储根目录（相对 apps/server 运行目录，容器内挂载 /app/media）
MEDIA_ROOT=./data/media
# AI 图片/视频审核（AV-05/06，OpenAI 兼容多模态网关）
AI_REVIEW_BASE_URL=
AI_REVIEW_MODEL=
AI_REVIEW_API_KEY=
# 告警 webhook（DV-07/SY-03，JSON: {content, image?}）
ALERT_WEBHOOK_URL=
# 媒体下载限速 MB/s（PB-10）
DOWNLOAD_RATE_MBPS=8
