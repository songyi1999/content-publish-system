{
  "name": "@cps/client-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Windows 终端客户端（Electron kiosk 全屏 + 自动更新，R10）",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12"
  }
}
