<?xml version="1.0" encoding="utf-8"?>
<!-- D8-A 内网 HTTPS：信任随包内置的自签 CA（scripts/gen-certs.sh 生成） -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="@raw/ca" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
